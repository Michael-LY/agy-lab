{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./plugins/agy",
      "options": {
        "defaultMode": "plan",
        "defaultModel": "gemini-3.8-flash-high",
        "complexModel": "gemini-4-argon-medium",
        "maxConcurrent": 2,
        "timeoutMinutes": 10,
        "outputDir": ".agy-out",
        "modelCacheTtlHours": 24,
        "notifyOnComplete": true
      }
    }
  ]
}
